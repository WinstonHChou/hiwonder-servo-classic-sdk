# cmake/hiwonder_servo_classicConfig.cmake.in
#
# Package config for downstream users of:
#
#   find_package(hiwonder_servo_classic REQUIRED)
#   target_link_libraries(my_app PRIVATE HiwonderBus::hiwonder_servo_classic)
#
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# SerialBus holds a std::mutex, so Threads is a real runtime dependency.
find_dependency(Threads)

if(NOT TARGET HiwonderBus::hiwonder_servo_classic)
  include("${CMAKE_CURRENT_LIST_DIR}/hiwonder_servo_classicTargets.cmake")
endif()

set_and_check(hiwonder_servo_classic_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set(hiwonder_servo_classic_LIBRARIES HiwonderBus::hiwonder_servo_classic)
set(hiwonder_servo_classic_VERSION "@PROJECT_VERSION@")

check_required_components(hiwonder_servo_classic)
