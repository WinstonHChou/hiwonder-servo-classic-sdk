# Type stubs for hiwonder_bus -- consumed by mypy/pyright/pylance.
#
# The native module is compiled, so these stubs are the authoritative source of
# signatures for editors. Keep them in sync with python/bindings.cpp.
#
from __future__ import annotations

from enum import Enum, IntEnum
from typing import Any, Dict, List, Optional, Sequence, Tuple

__version__: str

class ErrorMode(Enum):
    STRICT = 0
    NON_THROWING = 1

class Command(IntEnum):
    MOVE = 1
    READ_LAST_INSTANT_MOVE = 2
    MOVE_WAIT = 7
    READ_LAST_DELAYED_MOVE = 8
    MOVE_START = 11
    MOVE_STOP = 12
    WRITE_ID = 13
    READ_ID = 14
    WRITE_ANGLE_OFFSET = 17
    SAVE_ANGLE_OFFSET = 18
    READ_ANGLE_OFFSET = 19
    WRITE_ANGLE_LIMITS = 20
    READ_ANGLE_LIMITS = 21
    WRITE_VIN_LIMITS = 22
    READ_VIN_LIMITS = 23
    WRITE_TEMP_LIMIT = 24
    READ_TEMP_LIMIT = 25
    READ_TEMP = 26
    READ_VIN = 27
    READ_PHYSICAL_ANGLE = 28
    WRITE_MOTOR_MODE = 29
    READ_MOTOR_MODE = 30
    WRITE_TORQUE = 31
    READ_TORQUE = 32
    WRITE_LED = 33
    READ_LED = 34
    WRITE_LED_ERROR_TRIGGERS = 35
    READ_LED_ERROR_TRIGGERS = 36

class ErrorCode(Enum):
    OK = 0
    NOT_OPEN = 1
    TIMEOUT = 2
    SHORT_READ = 3
    BAD_CHECKSUM = 4
    BAD_FRAME = 5
    FIRMWARE_STATUS = 6
    INVALID_ARGUMENT = 7
    INVALID_STATE = 8
    IO_ERROR = 9
    PORT_BUSY = 10
    UNSUPPORTED = 11

class ServoConfig:
    max_ticks: int
    min_angle_deg: float
    max_angle_deg: float
    def __init__(self, max_ticks: int = ..., min_angle_deg: float = ..., max_angle_deg: float = ...) -> None: ...
    @staticmethod
    def classic() -> ServoConfig: ...
    def deg_per_tick(self) -> float: ...
    def span_deg(self) -> float: ...
    def to_ticks(self, angle_deg: float) -> int: ...
    def to_degrees(self, ticks: int) -> float: ...

class BusConfig:
    device: str
    baudrate: int
    read_timeout_ms: int
    write_timeout_ms: int
    enable_low_latency: bool
    flush_before_query: bool
    reject_tx_echo: bool
    max_retries: int
    strict_status: bool
    exclusive: bool
    rx_buffer_size: int
    error_mode: ErrorMode
    def __init__(self, device: str = ...) -> None: ...

class BusStats:
    tx_bytes: int
    rx_bytes: int
    writes: int
    transactions: int
    timeouts: int
    checksum_errors: int
    io_errors: int
    echo_drops: int

class LedTriggers:
    over_temperature: bool
    over_voltage: bool
    rotor_locked: bool
    def __init__(
        self,
        over_temperature: bool = ...,
        over_voltage: bool = ...,
        rotor_locked: bool = ...,
    ) -> None: ...
    def to_mask(self) -> int: ...
    @staticmethod
    def from_mask(mask: int) -> LedTriggers: ...

class Telemetry:
    id: int
    angle_deg: float
    vin_mv: int
    temp_c: int
    valid: bool

class SerialBus:
    device: str
    transport: str
    read_timeout_ms: int
    write_timeout_ms: int
    error_mode: ErrorMode
    baudrate: int
    config: BusConfig

    def __init__(
        self,
        device: str = ...,
        baudrate: int = ...,
        read_timeout_ms: int = ...,
        write_timeout_ms: int = ...,
        low_latency: bool = ...,
        error_mode: ErrorMode = ...,
    ) -> None: ...
    def open(self, device: str) -> bool: ...
    def close(self) -> None: ...
    def is_open(self) -> bool: ...
    def last_hint(self) -> str: ...
    def last_error(self) -> str: ...
    def last_error_code(self) -> ErrorCode: ...
    def clear_last_error(self) -> None: ...
    def stats(self) -> BusStats: ...
    def reset_stats(self) -> None: ...
    def set_poll_hardware(self, poll_hardware: bool) -> None: ...
    def apply_config(self) -> bool: ...
    def update_config(self, config: BusConfig) -> bool: ...

    def command(self, id: int, opcode: int, args: Sequence[int] = ...) -> int: ...
    def query(
        self, id: int, opcode: int, args: Sequence[int] = ..., timeout_ms: int = ...
    ) -> List[int]: ...

    def move_sync(
        self,
        ids: Sequence[int],
        angles: Sequence[float],
        time_ms: int = ...,
        start: bool = ...,
        config: Optional[ServoConfig] = ...,
    ) -> int: ...
    def set_torque(self, ids: Sequence[int], enable: bool) -> int: ...
    def read_angles(
        self, ids: Sequence[int], config: Optional[ServoConfig] = ...
    ) -> List[float]: ...
    def read_telemetry(
        self, ids: Sequence[int], config: Optional[ServoConfig] = ...
    ) -> List[Telemetry]: ...
    def broadcast_move_start(self) -> bool: ...
    def broadcast_move_stop(self) -> bool: ...
    def flush_input(self) -> bool: ...
    def flush_output(self) -> bool: ...
    def scan_ids(
        self,
        first: int = ...,
        last: int = ...,
        probe: int = ...,
        timeout_ms: int = ...,
    ) -> List[int]: ...

class Servo:
    id: int
    config: ServoConfig

    def __init__(
        self, bus: SerialBus, id: int, config: Optional[ServoConfig] = ...
    ) -> None: ...

    def bus(self) -> SerialBus: ...
    def initialize(self, disable_torque: bool = ...) -> None: ...
    def refresh(self) -> bool: ...
    def set_config(self, config: ServoConfig) -> None: ...

    def get_id(self, poll_hardware: bool = ...) -> int: ...
    def set_id(self, new_id: int) -> None: ...

    def move(
        self,
        angle: float,
        time: int = ...,
        relative: bool = ...,
        wait: bool = ...,
    ) -> None: ...
    def move_to(self, angle: float, time: int = ..., wait: bool = ...) -> None: ...
    def move_relative(self, angle: float, time: int = ..., wait: bool = ...) -> None: ...
    def move_start(self) -> None: ...
    def move_stop(self) -> None: ...
    def is_waiting_for_move(self) -> bool: ...
    def get_physical_angle(self, poll_hardware: bool = ...) -> float: ...
    def get_commanded_angle(self) -> float: ...
    def get_waiting_angle(self) -> float: ...
    def get_last_instant_move(self) -> Tuple[float, int]: ...
    def get_last_delayed_move(self) -> Tuple[float, int]: ...

    def enable_torque(self) -> None: ...
    def disable_torque(self) -> None: ...
    def is_torque_enabled(self, poll_hardware: bool = ...) -> bool: ...

    def set_motor_mode(self, speed: int) -> None: ...
    def set_servo_mode(self) -> None: ...
    def is_motor_mode(self, poll_hardware: bool = ...) -> bool: ...
    def get_motor_speed(self, poll_hardware: bool = ...) -> int: ...

    def set_angle_offset(self, offset: float, permanent: bool = ...) -> None: ...
    def get_angle_offset(self, poll_hardware: bool = ...) -> float: ...
    def set_angle_limits(self, min: float, max: float) -> None: ...
    def get_angle_limits(self, poll_hardware: bool = ...) -> Tuple[float, float]: ...
    def set_vin_limits(self, min: int, max: int) -> None: ...
    def get_vin_limits(self, poll_hardware: bool = ...) -> Tuple[int, int]: ...
    def set_temp_limit(self, max_temp_c: int) -> None: ...
    def get_temp_limit(self, poll_hardware: bool = ...) -> int: ...

    def get_temp(self) -> int: ...
    def get_vin(self) -> int: ...
    def read_telemetry(self) -> Telemetry: ...

    def led_power_on(self) -> None: ...
    def led_power_off(self) -> None: ...
    def is_led_power_on(self, poll_hardware: bool = ...) -> bool: ...
    def set_led_error_triggers(
        self, over_temperature: bool, over_voltage: bool, rotor_locked: bool
    ) -> None: ...
    def get_led_error_triggers(self, poll_hardware: bool = ...) -> Tuple[bool, bool, bool]: ...

    def healthy(self) -> bool: ...
    def last_error(self) -> ErrorCode: ...
    def last_message(self) -> str: ...
    def try_move(
        self,
        angle: float,
        time: int = ...,
        relative: bool = ...,
        wait: bool = ...,
    ) -> Tuple[bool, ErrorCode]: ...
    def try_get_physical_angle(self, poll_hardware: bool = ...) -> Tuple[bool, float]: ...
    def try_set_torque(self, enable: bool) -> Tuple[bool, ErrorCode]: ...
    def angle_to_ticks(self, angle_deg: float) -> int: ...
    def ticks_to_angle(self, ticks: int) -> float: ...

# C++ namespace aliases; the same class objects as SerialBus / Servo.
Bus = SerialBus
LX16ABus = SerialBus
LX16A = Servo
LX15D = Servo
LX224 = Servo
LX225 = Servo
HTS35H = Servo
HV206 = Servo

def move_sync(
    bus: SerialBus,
    servos: Sequence[Servo],
    angles: Sequence[float],
    time_ms: int = ...,
    start: bool = ...,
) -> int: ...
def read_angles(
    bus: SerialBus, servos: Sequence[Servo], poll_hardware: bool = ...
) -> List[float]: ...
def read_telemetry(bus: SerialBus, servos: Sequence[Servo]) -> List[Telemetry]: ...
def set_torque(bus: SerialBus, servos: Sequence[Servo], enable: bool) -> int: ...

def angle_to_ticks(angle_deg: float, config: ServoConfig = ...) -> int: ...
def ticks_to_angle(ticks: int, config: ServoConfig = ...) -> float: ...
def checksum(frame: Sequence[int]) -> int: ...
def build_packet(id: int, opcode: int, args: Sequence[int] = ...) -> List[int]: ...
def parse_response(frame: Sequence[int]) -> Tuple[int, int, int, List[int], bool]: ...
def version() -> str: ...
def sleep_ms(ms: int) -> None: ...
def make_simulated_bus(ids: Sequence[int], seed: Any = ...) -> SerialBus: ...
def simulate_disconnect(bus: SerialBus, id: int, present: bool = ...) -> bool: ...

def connect(
    port: str,
    *,
    baudrate: int = ...,
    read_timeout_ms: int = ...,
    write_timeout_ms: int = ...,
    low_latency: bool = ...,
    error_mode: Optional[ErrorMode] = ...,
) -> SerialBus: ...

# --- Exceptions -------------------------------------------------------------
class ServoError(Exception):
    id_: Optional[int]
    message: str
    def __init__(self, message: str, id_: Optional[int] = ...) -> None: ...

class ServoTimeoutError(ServoError): ...
class ServoChecksumError(ServoError): ...
class ServoArgumentError(ServoError): ...
class ServoLogicalError(ServoError): ...
class ServoIOError(ServoError): ...
class ServoFirmwareError(ServoError): ...

__all__ = [
    "Bus",
    "BusConfig",
    "BusStats",
    "Command",
    "ErrorCode",
